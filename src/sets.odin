package main

// ============================================================================
// SPECIES SETS
//
// Every species can be fought as one of a few **sets**: a loadout of ability,
// item and deck. The Arena's team builder picks a species (weighted by floor,
// so tougher monsters ramp in as you climb) and then rolls one of its sets, so
// the same species can show up as a striker, a controller or a bulwark.
//
// These are generated from each species' own move pool as a starting point —
// edit them freely.
// ============================================================================

MAX_SETS :: 3

Species_Set :: struct {
	name:    string,
	ability: Ability,
	item:    Item,
	deck:    []Move_Id,
}

SPECIES_SETS := [Species_Id][MAX_SETS]Species_Set{
